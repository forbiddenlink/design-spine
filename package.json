{
  "name": "design-spine",
  "version": "0.2.0",
  "description": "Screenshot every route and state of your Next.js app, then approve each screen by eye. Local, no account.",
  "license": "MIT",
  "author": "Elizabeth Stein",
  "homepage": "https://github.com/forbiddenlink/design-spine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forbiddenlink/design-spine.git"
  },
  "bugs": "https://github.com/forbiddenlink/design-spine/issues",
  "keywords": [
    "visual-regression",
    "screenshot",
    "nextjs",
    "playwright",
    "design-review",
    "ui-testing",
    "cli",
    "claude-code"
  ],
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.13"
  },
  "type": "module",
  "bin": {
    "spine": "bin/spine.js"
  },
  "scripts": {
    "build": "bun build --compile src/cli.ts src/lib/comparison-worker.ts --external 'chromium-bidi/*' --external electron --define 'import.meta.spineWorker=\"./lib/comparison-worker.js\"' --outfile dist/spine",
    "spine": "bun src/cli.ts",
    "test": "vitest run",
    "test:visual": "bun scripts/visual-tests.ts",
    "test:visual:update": "bun scripts/visual-tests.ts --update",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "commander": "^15.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "optionalDependencies": {
    "@oven/bun-darwin-aarch64": "1.3.13",
    "@oven/bun-darwin-x64": "1.3.13",
    "@oven/bun-linux-aarch64": "1.3.13",
    "@oven/bun-linux-aarch64-musl": "1.3.13",
    "@oven/bun-linux-x64": "1.3.13",
    "@oven/bun-linux-x64-musl": "1.3.13",
    "@oven/bun-windows-aarch64": "1.3.13",
    "@oven/bun-windows-x64": "1.3.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
